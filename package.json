{
  "name": "@tedi-design-system/vue",
  "version": "0.0.0-semantic-version",
  "license": "MIT",
  "description": "TEDI Design System Vue component library: accessible, reusable UI components.",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    "./tedi": {
      "types": "./src/tedi/index.d.ts",
      "import": "./tedi.es.js",
      "require": "./tedi.cjs"
    },
    "./community": {
      "types": "./src/community/index.d.ts",
      "import": "./community.es.js",
      "require": "./community.cjs"
    },
    "./index.css": "./index.css",
    "./index-without-icons.css": "./index-without-icons.css",
    "./icons/*.css": "./icons/*.css"
  },
  "scripts": {
    "prepare": "husky",
    "start": "storybook dev -p 4500 -c .storybook",
    "build": "rm -rf dist && vite build --config vite.lib.config.ts",
    "build:sb": "storybook build -c .storybook -o dist/storybook-static --stats-json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.lib.json && vue-tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.spec.json && vue-tsc --noEmit -p .storybook/tsconfig.json",
    "lint": "stylelint \"src/**/*.{scss,vue}\" --allow-empty-input --fix && eslint . --fix",
    "lint:ci": "stylelint \"src/**/*.{scss,vue}\" --allow-empty-input --quiet && eslint . --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ssr": "node scripts/ssr-smoke.mjs",
    "release": "npx semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TEDI-Design-System/vue.git"
  },
  "engines": {
    "npm": ">=11.0.0",
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@tedi-design-system/core": "6.13.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "chromatic": "^18.14.5",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "postcss-html": "^2.0.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.7",
    "stylelint": "^18.0.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "stylelint-order": "^8.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        1,
        "always",
        "start-case"
      ],
      "subject-min-length": [
        2,
        "always",
        10
      ],
      "references-empty": [
        2,
        "never"
      ]
    }
  },
  "lint-staged": {
    "src/**/*.{css,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "src/**/*.vue": [
      "stylelint --fix",
      "eslint --fix"
    ],
    "*.{js,ts}": [
      "eslint --fix"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
